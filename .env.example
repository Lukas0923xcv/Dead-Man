# SecureVault Configuration

# Primary web app port
PORT=8080

# Secondary dead man monitor dashboard port
MONITOR_PORT=8081

# Key size in bits (256 default, or 4096)
KEY_BITS=256

# Storage directory inside container
STORAGE_DIR=/app/data/vault

# Gmail / SMTP settings for Key B inheritance email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
